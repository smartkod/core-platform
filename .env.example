# Copy to .env and fill in. Never commit .env.
APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Host ports for docker compose. Change if another project owns them.
APP_PORT=8080
DB_PORT_HOST=55432

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=core_platform
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_SLOW_QUERY=200ms

HTTP_BODY_LIMIT=8M
HTTP_REQUEST_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=10s

LOG_LEVEL=info
LOG_FORMAT=json

# Required in production. Comma-separated; "*" is rejected in production.
CORS_ALLOWED_ORIGINS=

# Identity. Required in production; at least 32 characters, and the two values
# must differ.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
