# Copy to .env and fill in. Never commit .env.
APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Host ports for docker compose. Change if another project owns them.
APP_PORT=8080
DB_PORT_HOST=55432

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=core_platform
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_SLOW_QUERY=200ms

HTTP_BODY_LIMIT=8M
HTTP_REQUEST_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=10s

LOG_LEVEL=info
LOG_FORMAT=json

# Required in production. Comma-separated; "*" is rejected in production.
CORS_ALLOWED_ORIGINS=

# --- AI (L3) -------------------------------------------------------------
# Any OpenAI-compatible endpoint works. The key comes from the environment
# only; it must never appear in config.yaml or any tracked file.
AI_ENABLED=false
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=
AI_DEFAULT_MODEL=

# Identity (L1). Required in production; at least 32 characters, and the two
# values must differ.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# --- Economy (L2) --------------------------------------------------------
# How long a pending order may be paid before the expiry job closes it.
ECONOMY_ORDER_TTL=30m
# Expiry/ledger-audit sweep. 0s disables the worker.
ECONOMY_JOB_INTERVAL=1m

# Development only: enables the signed "test" payment adapter so the webhook
# path can be exercised without a gateway. It is ignored when APP_ENV is
# production, so a leaked development secret cannot settle a real order.
ECONOMY_TEST_WEBHOOK_SECRET=
