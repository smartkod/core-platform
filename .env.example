# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8081

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=${DB_PASSWORD}
DB_NAME=astroscope
DB_SSLMODE=disable

# Logger
LOG_LEVEL=info
LOG_FORMAT=json

# JWT
JWT_SECRET=${JWT_SECRET}
REFRESH_SECRET=${REFRESH_SECRET}

# External APIs
OPENAI_API_KEY=${OPENAI_API_KEY}
